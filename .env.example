# Frontend (Vite) - rename this file to .env and fill in your values.

# Optional: override the API base URL. Leave empty to use the defaults
# (localhost:3006 when developing locally, Netlify Functions in production).
VITE_API_URL=

# Backend (server/index.js) — set these in your hosting dashboard, not just this file.

# JWT secret for signing auth tokens. Use a long random string in production!
JWT_SECRET=

# Allowed CORS origins, comma-separated.
CORS_ORIGIN=http://localhost:5177,https://dreamhomes-realestate.netlify.app

# PostgreSQL connection string. When set, the server stores the DB snapshot
# in Postgres so data survives redeploys/restarts.  Falls back to a local
# SQLite file when unset.
DATABASE_URL=

# SMTP config for sending emails (tours, contact, password reset).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=

# Path to the local SQLite database file (used when DATABASE_URL is not set).
DB_PATH=

# Port for the API server.
PORT=3006

# --- AI chat assistant (/api/ai/chat) ---
# Set OPENAI_API_KEY to enable real LLM answers. Without it, the assistant
# falls back to a built-in rule-based engine that searches the listings.
OPENAI_API_KEY=

# Model used when OPENAI_API_KEY is set (defaults to gpt-4o-mini).
AI_MODEL=gpt-4o-mini

# Max time (ms) spent waiting on the LLM before falling back.
AI_TIMEOUT_MS=8500

# Password used when seeding a brand-new database with the default admin
# user. Only applies on a fresh install (when no users exist yet).
ADMIN_SEED_PASSWORD=