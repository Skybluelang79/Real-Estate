# Frontend (Vite) - rename this file to .env and fill in your values.

# WhatsApp floating button - add your number in E.164 format (country code + number, digits only).
# Example for a US number: 13105550123
# The button stays hidden until this is set.
VITE_WHATSAPP_NUMBER=

# Phone number used for the "Call" button in the live chat widget (E.164 format).
# Example for a US number: +13105550123
VITE_PHONE_NUMBER=

# Optional: override the API base URL. Leave empty to use the defaults
# (localhost:3006 when developing locally, Netlify Functions in production).
VITE_API_URL=

# ---- Backend (server/index.js) ----
# Set these in your hosting dashboard (Netlify/Render/Railway), not just this file.

# JWT secret for signing auth tokens. Use a long random string in production!
JWT_SECRET=

# Allowed CORS origins, comma-separated.
CORS_ORIGIN=http://localhost:5177,https://dreamhomes-realestate.netlify.app

# SMTP config for sending emails (tours, contact, password reset).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=

# Path to the SQLite database file.
DB_PATH=

# Port for the API server.
PORT=3006